digraph image_relations {
  graph [fontname="Helvetica" pad="0.5" nodesep="0.2" ranksep="0.3" compound=true];
  rankdir="LR";
  node [style="filled,rounded" shape=box fontname="Helvetica" fontsize=9];
  edge [color="#888888" arrowsize=0.7];

  subgraph cluster_legend {
    label="Status Legend";
    labeljust="l";
    style=dashed;
    color="#aaaaaa";
    fontsize=11;
    fontname="Helvetica-Bold";
    node [fontsize=8 width=0.8];
    legend_active [label="Active" fillcolor="#ccffcc"];
    legend_maint [label="Maintenance" fillcolor="#ffffcc"];
    legend_eol [label="EOL" fillcolor="#ffcccc"];
    legend_external [label="External" fillcolor="white"];
    legend_active -> legend_maint -> legend_eol -> legend_external [style=invis];
  }

  subgraph cluster_base {
    label="Base Images";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "debian-bookworm" [fillcolor="#ccffcc"];
    "debian-trixie" [fillcolor="#ccffcc"];
    "dib" [fillcolor="#ccffcc"];
    "toolbox-bookworm" [fillcolor="#ccffcc"];
  }

  subgraph cluster_database {
    label="Databases";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "mariadb10" [fillcolor="#ccffcc"];
    "mysql80-data" [fillcolor="#ccffcc"];
    "mysql80" [fillcolor="#ccffcc"];
    "mysql84" [fillcolor="#ccffcc"];
    "postgres12" [fillcolor="#ccffcc"];
  }

  subgraph cluster_php {
    label="PHP";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "php81-cli" [fillcolor="#ccffcc"];
    "php81-cron" [fillcolor="#ccffcc"];
    "php81-dev" [fillcolor="#ccffcc"];
    "php81-fpm" [fillcolor="#ccffcc"];
    "php81-supervisor" [fillcolor="#ccffcc"];
    "php82-cli" [fillcolor="#ccffcc"];
    "php82-cron" [fillcolor="#ccffcc"];
    "php82-dev" [fillcolor="#ccffcc"];
    "php82-fpm" [fillcolor="#ccffcc"];
    "php82-supervisor" [fillcolor="#ccffcc"];
    "php83-cli" [fillcolor="#ccffcc"];
    "php83-cron" [fillcolor="#ccffcc"];
    "php83-dev" [fillcolor="#ccffcc"];
    "php83-fpm" [fillcolor="#ccffcc"];
    "php83-supervisor" [fillcolor="#ccffcc"];
    "php84-cli" [fillcolor="#ccffcc"];
    "php84-cron" [fillcolor="#ccffcc"];
    "php84-dev" [fillcolor="#ccffcc"];
    "php84-fpm" [fillcolor="#ccffcc"];
    "php84-supervisor" [fillcolor="#ccffcc"];
    "php85-cli" [fillcolor="#ccffcc"];
    "php85-cron" [fillcolor="#ccffcc"];
    "php85-dev" [fillcolor="#ccffcc"];
    "php85-fpm" [fillcolor="#ccffcc"];
    "php85-supervisor" [fillcolor="#ccffcc"];
    "phpmyadmin" [fillcolor="#ccffcc"];
  }

  subgraph cluster_elasticsearch {
    label="Elasticsearch";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "elasticsearch84" [fillcolor="#ccffcc"];
  }

  subgraph cluster_nodejs {
    label="Node.js";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "node22" [fillcolor="#ccffcc"];
    "node24" [fillcolor="#ccffcc"];
    "nodeserver22" [fillcolor="#ccffcc"];
    "nodeserver24" [fillcolor="#ccffcc"];
  }

  subgraph cluster_webserver {
    label="Web Servers";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "apache24" [fillcolor="#ccffcc"];
    "nginx122" [fillcolor="#ccffcc"];
  }

  subgraph cluster_cache_queue {
    label="Cache / Queue";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "memcached16" [fillcolor="#ccffcc"];
    "rabbitmq310" [fillcolor="#ccffcc"];
    "rabbitmq312" [fillcolor="#ccffcc"];
    "rabbitmq4" [fillcolor="#ccffcc"];
    "redis70" [fillcolor="#ccffcc"];
  }

  subgraph cluster_docker {
    label="Docker Tools";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "docker18ce" [fillcolor="#ccffcc"];
  }

  subgraph cluster_tools {
    label="Other Tools";
    labeljust="l";
    style="rounded,filled";
    fillcolor="#f8f8f8";
    color="#cccccc";
    fontname="Helvetica-Bold";
    fontsize=11;
    "aws-docker-tools" [fillcolor="#ccffcc"];
    "aws-mock" [fillcolor="#ccffcc"];
    "aws-tools" [fillcolor="#ccffcc"];
    "chromedriver" [fillcolor="#ccffcc"];
    "chromium" [fillcolor="#ccffcc"];
    "claude" [fillcolor="#ccffcc"];
    "cloud-tools" [fillcolor="#ccffcc"];
    "db-tools" [fillcolor="#ccffcc"];
    "dev" [fillcolor="#ccffcc"];
    "ffmpeg" [fillcolor="#ccffcc"];
    "fontforge" [fillcolor="#ccffcc"];
    "ghostscript" [fillcolor="#ccffcc"];
    "graphic-tools" [fillcolor="#ccffcc"];
    "lib-smartclient100" [fillcolor="#ccffcc"];
    "lib-smartclient111" [fillcolor="#ccffcc"];
    "lib-smartclient120" [fillcolor="#ccffcc"];
    "lib-smartclient121" [fillcolor="#ccffcc"];
    "lib-smartclient130" [fillcolor="#ccffcc"];
    "mailpit" [fillcolor="#ccffcc"];
    "opentripplanner" [fillcolor="#ccffcc"];
    "packager" [fillcolor="#ccffcc"];
    "pdftk" [fillcolor="#ccffcc"];
    "qpdf" [fillcolor="#ccffcc"];
    "ruby2" [fillcolor="#ccffcc"];
    "sonar-scanner-cli7" [fillcolor="#ccffcc"];
    "sonar-scanner-cli8" [fillcolor="#ccffcc"];
    "wkhtmltopdf126" [fillcolor="#ccffcc"];
  }

  // Dependencies
  "debian-bookworm" -> "apache24";
  "aws-tools" -> "aws-docker-tools";
  "debian-bookworm" -> "aws-mock";
  "toolbox-bookworm" -> "aws-tools";
  "debian-bookworm" -> "chromedriver";
  "toolbox-bookworm" -> "chromium";
  "debian-trixie" -> "claude";
  "toolbox-bookworm" -> "cloud-tools";
  "toolbox-bookworm" -> "db-tools";
  "debian:bookworm" -> "debian-bookworm";
  "debian:trixie" -> "debian-trixie";
  "debian-bookworm" -> "dev";
  "debian:bookworm" -> "dib";
  "debian-bookworm" -> "docker18ce";
  "debian-bookworm" -> "elasticsearch84";
  "toolbox-bookworm" -> "ffmpeg";
  "toolbox-bookworm" -> "fontforge";
  "toolbox-bookworm" -> "ghostscript";
  "toolbox-bookworm" -> "graphic-tools";
  "alpine" -> "lib-smartclient100";
  "alpine" -> "lib-smartclient111";
  "alpine" -> "lib-smartclient120";
  "alpine" -> "lib-smartclient121";
  "alpine" -> "lib-smartclient130";
  "debian-bookworm" -> "mailpit";
  "mariadb:10" -> "mariadb10";
  "debian-bookworm" -> "memcached16";
  "mysql80" -> "mysql80-data";
  "mysql:8.0" -> "mysql80";
  "mysql:8.4" -> "mysql84";
  "debian-bookworm" -> "nginx122";
  "toolbox-bookworm" -> "node22";
  "toolbox-bookworm" -> "node24";
  "debian-bookworm" -> "nodeserver22";
  "debian-bookworm" -> "nodeserver24";
  "opentripplanner/opentripplanner:2.8.1" -> "opentripplanner";
  "toolbox-bookworm" -> "packager";
  "toolbox-bookworm" -> "pdftk";
  "debian-bookworm" -> "php81-cli";
  "php81-cli" -> "php81-cron";
  "php81-cli" -> "php81-dev";
  "php81-cli" -> "php81-fpm";
  "php81-cli" -> "php81-supervisor";
  "debian-bookworm" -> "php82-cli";
  "php82-cli" -> "php82-cron";
  "php82-cli" -> "php82-dev";
  "php82-cli" -> "php82-fpm";
  "php82-cli" -> "php82-supervisor";
  "debian-bookworm" -> "php83-cli";
  "php83-cli" -> "php83-cron";
  "php83-cli" -> "php83-dev";
  "php83-cli" -> "php83-fpm";
  "php83-cli" -> "php83-supervisor";
  "debian-bookworm" -> "php84-cli";
  "php84-cli" -> "php84-cron";
  "php84-cli" -> "php84-dev";
  "php84-cli" -> "php84-fpm";
  "php84-cli" -> "php84-supervisor";
  "debian-trixie" -> "php85-cli";
  "php85-cli" -> "php85-cron";
  "php85-cli" -> "php85-dev";
  "php85-cli" -> "php85-fpm";
  "php85-cli" -> "php85-supervisor";
  "php82-cli" -> "phpmyadmin";
  "postgres:12" -> "postgres12";
  "toolbox-bookworm" -> "qpdf";
  "debian-bookworm" -> "rabbitmq310";
  "debian-bookworm" -> "rabbitmq312";
  "debian-bookworm" -> "rabbitmq4";
  "debian-bookworm" -> "redis70";
  "toolbox-bookworm" -> "ruby2";
  "toolbox-bookworm" -> "sonar-scanner-cli7";
  "toolbox-bookworm" -> "sonar-scanner-cli8";
  "debian-bookworm" -> "toolbox-bookworm";
  "toolbox-bookworm" -> "wkhtmltopdf126";

  // External base images
  "alpine" [fillcolor=white style="filled,rounded,dashed"];
  "debian:bookworm" [fillcolor=white style="filled,rounded,dashed"];
  "debian:trixie" [fillcolor=white style="filled,rounded,dashed"];
  "mariadb:10" [fillcolor=white style="filled,rounded,dashed"];
  "mysql:8.0" [fillcolor=white style="filled,rounded,dashed"];
  "mysql:8.4" [fillcolor=white style="filled,rounded,dashed"];
  "opentripplanner/opentripplanner:2.8.1" [fillcolor=white style="filled,rounded,dashed"];
  "postgres:12" [fillcolor=white style="filled,rounded,dashed"];
}
