#!/bin/bash
set -e

IMG="$1"

echo -n "Checking CLAUDE_CONFIG_DIR ... "
VAL="$(docker run --rm "$IMG" printenv CLAUDE_CONFIG_DIR)"
if [ "$VAL" = "/home/project/.claude" ]; then
	echo OK
else
	echo "FAILED (got '$VAL')"
	exit 1
fi

echo -n "Checking /home/project/.claude is owned by project with mode 700 ... "
STAT="$(docker run --rm "$IMG" stat -c '%U:%G %a' /home/project/.claude)"
if [ "$STAT" = "project:project 700" ]; then
	echo OK
else
	echo "FAILED (got '$STAT')"
	exit 1
fi

echo -n "Checking managed settings contain only DISABLE_AUTOUPDATER ... "
VAL="$(docker run --rm "$IMG" jq -cS . /etc/claude-code/managed-settings.json)"
EXPECTED='{"env":{"DISABLE_AUTOUPDATER":"1"}}'
if [ "$VAL" = "$EXPECTED" ]; then
	echo OK
else
	echo "FAILED (got '$VAL')"
	exit 1
fi
