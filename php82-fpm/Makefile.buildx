# PILOT: buildx-based Makefile for this image only.
# Every other image still uses ../_tools/makefiles/base-image-Makefile.
#
# The registry holds exactly six tags per image, same as the old process:
#   :amd64 :arm64        newest build of each arch (written by `push`, after tests pass)
#   :1-amd64 :1-arm64    previous build of each arch  } written only by `promote`
#   :1                   previous multi-arch build    }
#   :latest              newest multi-arch build      }
#
# Flow: each arch job runs `make build test push`; one final job runs
# `make promote publish`. Consumers only ever see :latest / :1, and those
# move together in `promote`, so a failed arch build never leaves them mixed.

IMAGE_NAME         = $(notdir $(CURDIR))
IMAGE_TYPE         = nfqlt
IMAGE_REGISTRY    ?= docker.nfq.lt/
PARENT_REGISTRY   ?= $(IMAGE_REGISTRY)
IMAGE_FULL_NAME    = $(IMAGE_REGISTRY)$(IMAGE_TYPE)/$(IMAGE_NAME)
IMAGE_PUBLISH_NAME = $(IMAGE_TYPE)/$(IMAGE_NAME)
NO_CACHE ?= false
ARCHES ?= amd64 arm64
# Every tag that exists in the registry for this image (mirrored by `publish`).
TAGS = latest 1 $(ARCHES) $(addprefix 1-,$(ARCHES))
# Parent image this Dockerfile FROMs, e.g. "nfqlt/php81-cli".
# Same fact the old sed hack needed — read once here instead of regexed at build time.
PARENT_IMAGE = $(shell grep '^FROM ' Dockerfile | head -1 | awk '{print $$2}')
ARCH ?= $(shell docker version -f '{{.Server.Arch}}')

# Where to resolve PARENT_IMAGE from for this build. Defaults to the registry's
# multi-arch "latest" manifest (so it resolves to whatever arch you're on).
# Override for a fully offline test, e.g.:
#   make build PARENT_REF=docker.nfq.lt/nfqlt/php81-cli:local
PARENT_REF  ?= $(PARENT_REGISTRY)$(PARENT_IMAGE):latest
ifeq ($(PARENT_IMAGE),)
$(error could not determine parent image from Dockerfile)
endif

.PHONY: help build test push all promote publish run run-bash clean status get-image-name
.SILENT: status get-image-name

help:
	@echo
	@echo "Image:   $(IMAGE_FULL_NAME)"
	@echo "Arch:    $(ARCH)"
	@echo "Parent:  $(PARENT_IMAGE) <- $(PARENT_REF)"
	@echo "Tags:    $(TAGS)"
	@echo "Targets: build test push all promote publish run run-bash clean status"
	@echo

build:
	@echo
	@echo "# [buildx] Building $(IMAGE_FULL_NAME):$(ARCH) (parent: $(PARENT_REF))"
	@echo
	docker buildx build \
	    --pull \
	    --platform linux/$(ARCH) \
	    --build-context $(PARENT_IMAGE)=docker-image://$(PARENT_REF) \
	    $(if $(filter true,$(NO_CACHE)),--no-cache,) \
	    --load \
	    -t $(IMAGE_FULL_NAME):$(ARCH) \
	    .
	$(MAKE) status

test:
	@echo
	@echo "# Testing image..."
	@echo
	if [ -d test ]; then \
	    run-parts -v -a $(IMAGE_FULL_NAME):$(ARCH) test; \
	fi
	@echo
	@echo "Tests passed. ($(shell run-parts --test test | wc -l))"
	@echo

all: build test push

push:
	@echo
	@echo "# Pushing $(IMAGE_FULL_NAME):$(ARCH) to registry..."
	@echo
	docker push $(IMAGE_FULL_NAME):$(ARCH)

# Run once, after every arch has been pushed. The only target that touches :latest, :1 and :1-<arch>.
promote:
	@echo
	@echo "# Promoting :$(ARCHES) to :latest (previous :latest -> :1)..."
	@echo
	set -e; \
	plat() { docker buildx imagetools inspect "$$1" 2>/dev/null | awk -v p="linux/$$2" '/^Digest:/ && d=="" {d=$$2} /^ *Name:/ && $$2 ~ /@sha256:/ {cur=$$2; sub(/.*@/,"",cur)} /^ *Platform:/ && $$2==p && cur!="" {print cur; f=1; exit} END {if(!f && d!="") print d}'; }; \
	for a in $(ARCHES); do \
	    [ -n "$$(plat $(IMAGE_FULL_NAME):$$a $$a)" ] || { echo "ERROR: $(IMAGE_FULL_NAME):$$a not found, push it first"; exit 1; }; \
	done; \
	SAME=1; \
	for a in $(ARCHES); do \
	    [ "$$(plat $(IMAGE_FULL_NAME):$$a $$a)" = "$$(plat $(IMAGE_FULL_NAME):latest $$a)" ] || SAME=0; \
	done; \
	if [ $$SAME = 1 ]; then echo "# :latest already built from the current :<arch> images, nothing to do"; exit 0; fi; \
	OLD=$$(docker buildx imagetools inspect $(IMAGE_FULL_NAME):latest 2>/dev/null | awk '/^Digest:/ {print $$2; exit}' || true); \
	if [ -n "$$OLD" ]; then \
	    for a in $(ARCHES); do \
	        d=$$(plat $(IMAGE_FULL_NAME):latest $$a); \
	        [ -z "$$d" ] || docker buildx imagetools create --tag $(IMAGE_FULL_NAME):1-$$a $(IMAGE_FULL_NAME)@$$d; \
	    done; \
	    docker buildx imagetools create --tag $(IMAGE_FULL_NAME):1 $(IMAGE_FULL_NAME)@$$OLD; \
	fi; \
	docker buildx imagetools create --tag $(IMAGE_FULL_NAME):latest $(foreach a,$(ARCHES),$(IMAGE_FULL_NAME):$(a)); \
	if [ -z "$$OLD" ]; then \
	    echo "# first build: :1 and :1-<arch> start out equal to the new build"; \
	    for a in $(ARCHES); do docker buildx imagetools create --tag $(IMAGE_FULL_NAME):1-$$a $(IMAGE_FULL_NAME):$$a; done; \
	    docker buildx imagetools create --tag $(IMAGE_FULL_NAME):1 $(IMAGE_FULL_NAME):latest; \
	fi

# Copies all six tags to Docker Hub, registry to registry
publish:
	@echo
	@echo "# Mirroring $(TAGS) -> $(IMAGE_PUBLISH_NAME) (Docker Hub)..."
	@echo
	$(foreach t,$(TAGS),docker buildx imagetools create --tag $(IMAGE_PUBLISH_NAME):$(t) $(IMAGE_FULL_NAME):$(t) && ) true

run:
	docker run -it --rm $(IMAGE_FULL_NAME):$(ARCH)

run-bash:
	docker run -it --rm $(IMAGE_FULL_NAME):$(ARCH) env TERM=xterm bash -l

clean:
	docker rmi $(IMAGE_FULL_NAME):$(ARCH) 2>/dev/null || true
	$(MAKE) status

status:
	docker images | grep -i "$(IMAGE_FULL_NAME) " || true

get-image-name:
	echo $(IMAGE_FULL_NAME)
